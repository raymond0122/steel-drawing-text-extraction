# Copy this file to .env and fill in the values. .env is in .gitignore: never commit it.
# It is read from the working directory, so run the commands from the repository root.
# Environment variables set in the shell win over this file; empty values here are ignored.
# Only live mode (steel-demo --live, or Live in the web UI) needs the Azure and OpenAI keys.

# --- Azure AI Document Intelligence (OCR) ---------------------------------------
# Azure portal > your Document Intelligence resource > Keys and Endpoint.
# The endpoint looks like https://<your-resource>.cognitiveservices.azure.com
AZURE_DOCINT_ENDPOINT=
AZURE_DOCINT_KEY=

# --- OpenAI (LLM label filter) ------------------------------------------------
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- Auth API ---------------------------------------------------------------------
# Signs the JWTs. If unset, a random key is used and tokens stop working on restart.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=
# Where the SQLite user store lives (default: auth.db in the working directory).
AUTH_DB_PATH=
